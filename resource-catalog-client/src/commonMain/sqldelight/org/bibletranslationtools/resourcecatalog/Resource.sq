CREATE TABLE resource (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    slug TEXT NOT NULL,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    translate_mode TEXT NOT NULL,
    checking_level TEXT NOT NULL,
    comments TEXT DEFAULT NULL,
    pub_date TEXT DEFAULT NULL,
    license TEXT DEFAULT NULL,
    version TEXT NOT NULL,
    project_id INTEGER NOT NULL,
    UNIQUE (project_id, slug),
    FOREIGN KEY (project_id) REFERENCES project (id) ON DELETE CASCADE
);

CREATE INDEX resource_slug ON resource(slug);
CREATE INDEX resource_translate_mode ON resource(translate_mode);
CREATE INDEX resource_checking_level ON resource(checking_level);
CREATE INDEX resource_project_id ON resource(project_id);

upsert:
INSERT INTO resource (
    slug, name, type, translate_mode, checking_level,
    comments, pub_date, license, version, project_id
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(project_id, slug) DO UPDATE SET
    name = excluded.name,
    type = excluded.type,
    translate_mode = excluded.translate_mode,
    checking_level = excluded.checking_level,
    comments = excluded.comments,
    pub_date = excluded.pub_date,
    license = excluded.license,
    version = excluded.version;

selectIdByProjectAndSlug:
SELECT id
FROM resource
WHERE project_id = ? AND slug = ?
LIMIT 1;

selectOneWithLegacy:
SELECT
    r.id, r.name, r.translate_mode, r.type, r.checking_level,
    r.comments, r.pub_date, r.license, r.version,
    lri.translation_words_assignments_url
FROM resource AS r
LEFT JOIN legacy_resource_info AS lri ON lri.resource_id = r.id
WHERE r.slug = :resourceSlug
  AND r.project_id IN (
      SELECT id FROM project
      WHERE slug = :projectSlug
        AND source_language_id IN (SELECT id FROM source_language WHERE slug = :languageSlug)
  )
LIMIT 1;

selectByProjectAndLanguage:
SELECT r.*, lri.translation_words_assignments_url
FROM resource AS r
LEFT JOIN legacy_resource_info AS lri ON lri.resource_id = r.id
WHERE r.project_id IN (
    SELECT id FROM project
    WHERE slug = :projectSlug
      AND source_language_id IN (SELECT id FROM source_language WHERE slug = :languageSlug)
)
ORDER BY r.slug ASC;

selectByProject:
SELECT
    sl.slug AS source_language_slug,
    r.id, r.slug, r.name, r.type, r.translate_mode, r.checking_level,
    r.comments, r.pub_date, r.license, r.version, r.project_id,
    lri.translation_words_assignments_url
FROM resource AS r
LEFT JOIN legacy_resource_info AS lri ON lri.resource_id = r.id
LEFT JOIN project AS p ON p.id = r.project_id
LEFT JOIN source_language AS sl ON sl.id = p.source_language_id
WHERE p.slug = ?
ORDER BY r.slug ASC;

-- findTranslations, with optional maxCheckingLevel.
-- Empty filters should be passed as '%' to match anything.
findTranslations:
SELECT
    l.slug AS language_slug, l.name AS language_name, l.direction,
    p.slug AS project_slug, p.name AS project_name, p.desc, p.icon, p.sort, p.chunks_url,
    r.id AS resource_id, r.slug AS resource_slug, r.name AS resource_name,
    r.type, r.translate_mode, r.checking_level, r.comments, r.pub_date, r.license, r.version,
    lri.translation_words_assignments_url,
    COUNT(CASE WHEN rf.imported = 1 THEN 1 END) AS num_imported
FROM source_language AS l
LEFT JOIN project AS p ON p.source_language_id = l.id
LEFT JOIN resource AS r ON r.project_id = p.id
LEFT JOIN resource_format AS rf ON rf.resource_id = r.id
LEFT JOIN legacy_resource_info AS lri ON lri.resource_id = r.id
WHERE l.slug LIKE :languageSlug
  AND p.slug LIKE :projectSlug
  AND r.slug LIKE :resourceSlug
  AND r.type LIKE :resourceType
GROUP BY r.id
HAVING (
    (r.checking_level >= :minCheckingLevel
     AND (:maxCheckingLevel < 0 OR r.checking_level <= :maxCheckingLevel)
     AND r.translate_mode LIKE :translateMode)
    OR num_imported > 0
);

importedTranslations:
SELECT
    l.slug AS language_slug, l.name AS language_name, l.direction,
    p.slug AS project_slug, p.name AS project_name, p.desc, p.icon, p.sort, p.chunks_url,
    r.id AS resource_id, r.slug AS resource_slug, r.name AS resource_name,
    r.type, r.translate_mode, r.checking_level, r.comments, r.pub_date, r.license, r.version,
    lri.translation_words_assignments_url,
    COUNT(CASE WHEN rf.imported = 1 THEN 1 END) AS num_imported
FROM source_language AS l
LEFT JOIN project AS p ON p.source_language_id = l.id
LEFT JOIN resource AS r ON r.project_id = p.id
LEFT JOIN resource_format AS rf ON rf.resource_id = r.id
LEFT JOIN legacy_resource_info AS lri ON lri.resource_id = r.id
GROUP BY r.id
HAVING num_imported > 0;
