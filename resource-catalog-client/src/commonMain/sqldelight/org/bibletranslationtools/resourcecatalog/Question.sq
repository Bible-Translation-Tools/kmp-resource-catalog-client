CREATE TABLE question (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    text TEXT NOT NULL,
    help TEXT NOT NULL,
    is_required INTEGER NOT NULL DEFAULT 0,
    input_type TEXT NOT NULL,
    sort INTEGER NOT NULL DEFAULT 0,
    depends_on INTEGER NOT NULL DEFAULT -1,
    td_id INTEGER NOT NULL,
    questionnaire_id INTEGER NOT NULL,
    UNIQUE (td_id, questionnaire_id),
    FOREIGN KEY (questionnaire_id) REFERENCES questionnaire (id) ON DELETE CASCADE
);

CREATE INDEX question_depends_on ON question(depends_on);

selectAll:
SELECT *
FROM question;

selectById:
SELECT *
FROM question
WHERE id = ?;

selectByQuestionnaire:
SELECT *
FROM question
WHERE questionnaire_id = ?
ORDER BY sort ASC;

selectByQuestionnaireAndTdId:
SELECT *
FROM question
WHERE questionnaire_id = ? AND td_id = ?;

selectByDependsOn:
SELECT *
FROM question
WHERE depends_on = ?;

insert:
INSERT INTO question (
    text, help, is_required, input_type, sort, depends_on, td_id, questionnaire_id
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM question
WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
