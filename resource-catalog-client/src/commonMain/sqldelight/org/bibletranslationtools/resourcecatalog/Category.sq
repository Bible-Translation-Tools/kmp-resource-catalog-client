CREATE TABLE category (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    slug TEXT NOT NULL,
    parent_id INTEGER NOT NULL DEFAULT 0,
    UNIQUE (slug, parent_id)
);

CREATE INDEX category_slug ON category(slug);
CREATE INDEX category_parent_id ON category(parent_id);

insertOrIgnore:
INSERT OR IGNORE INTO category (slug, parent_id)
VALUES (?, ?);

selectIdBySlugAndParent:
SELECT id
FROM category
WHERE slug = ? AND parent_id = ?
LIMIT 1;

selectByLanguageAndSlug:
SELECT c.slug, cn.name
FROM category AS c
LEFT JOIN category_name AS cn ON cn.category_id = c.id
LEFT JOIN source_language AS sl ON sl.id = cn.source_language_id
WHERE c.slug = :categorySlug AND sl.slug = :languageSlug
LIMIT 1;

selectParentByChildSlug:
SELECT pc.slug, pcn.name
FROM category AS pc
LEFT JOIN category AS cc ON cc.parent_id = pc.id
LEFT JOIN category_name AS pcn ON pcn.category_id = pc.id
LEFT JOIN source_language AS sl ON sl.id = pcn.source_language_id
WHERE cc.slug = :childSlug AND sl.slug = :languageSlug
LIMIT 1;

selectByProjectAndLanguage:
SELECT c.slug, cn.name
FROM category AS c
LEFT JOIN category_name AS cn ON cn.category_id = c.id
LEFT JOIN source_language AS sl ON sl.id = cn.source_language_id
LEFT JOIN project AS p ON p.source_language_id = sl.id AND p.category_id = c.id
WHERE p.slug = :projectSlug AND sl.slug = :languageSlug;
