CREATE TABLE versification (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    slug TEXT NOT NULL,
    UNIQUE (slug)
);

CREATE INDEX versification_slug ON versification(slug);

insertOrIgnore:
INSERT OR IGNORE INTO versification (slug)
VALUES (?);

selectIdBySlug:
SELECT id FROM versification WHERE slug = ?;

selectByLanguageAndSlug:
SELECT v.id, v.slug, vn.name
FROM versification_name AS vn
LEFT JOIN versification AS v ON v.id = vn.versification_id
LEFT JOIN source_language AS sl ON sl.id = vn.source_language_id
WHERE sl.slug = :languageSlug AND v.slug = :versificationSlug;

selectByLanguage:
SELECT v.id, v.slug, vn.name
FROM versification_name AS vn
LEFT JOIN versification AS v ON v.id = vn.versification_id
LEFT JOIN source_language AS sl ON sl.id = vn.source_language_id
WHERE sl.slug = ?;
